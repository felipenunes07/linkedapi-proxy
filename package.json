{
  "name": "linkedapi-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Camada proxy sobre a Unipile para automacao de LinkedIn (data plane).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "key:issue": "node scripts/keys.ts issue",
    "key:revoke": "node scripts/keys.ts revoke",
    "connect:link": "node scripts/connect.ts link",
    "connect:reconnect": "node scripts/connect.ts reconnect"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240000.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.80.0"
  }
}
