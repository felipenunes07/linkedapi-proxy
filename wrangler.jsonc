{
  // Config do Cloudflare Worker (data plane / proxy).
  // Segredos (UNIPILE_MASTER_TOKEN, UNIPILE_DSN, SUPABASE_*) NAO ficam aqui.
  // Em dev: `.dev.vars`. Em producao: `npx wrangler secret put <NOME>`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkedapi-proxy",
  // Conta do Victor (o token OAuth do Felipe acessa 2 contas; deploy vai nesta)
  "account_id": "58af046efff1765ebba08637bebcb580",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Rate limit por chave por janela (Marco 3). Em dev, `wrangler dev` simula o
  // KV localmente (miniflare), o `id` abaixo e so placeholder. Antes do deploy,
  // crie o namespace e troque o id:
  //   npx wrangler kv namespace create RATE_LIMIT
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "6418f47785a5457da8da180234fa5086" }
  ],

  // Variaveis NAO secretas podem ir em "vars". Segredos, nunca.
  "vars": {
    "ENVIRONMENT": "development"
  }
}
