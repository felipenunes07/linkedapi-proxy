{
  // Config do Cloudflare Worker (data plane / proxy).
  // Segredos (UNIPILE_MASTER_TOKEN, UNIPILE_DSN, SUPABASE_*) NAO ficam aqui.
  // Em dev: `.dev.vars`. Em producao: `npx wrangler secret put <NOME>`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkedapi-proxy",
  // Conta do Fernando (F2.34): e a que tem a zona playbooklab.com.br, e custom
  // domain de Worker exige zona e Worker na MESMA conta.
  "account_id": "31dab3c5b7eda847ef37a9f53e0aa893",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Rate limit por chave por janela (Marco 3). Em dev, `wrangler dev` simula o
  // KV localmente (miniflare), o `id` abaixo e so placeholder. Antes do deploy,
  // crie o namespace e troque o id:
  //   npx wrangler kv namespace create RATE_LIMIT
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "b79c9339f2084b8fbc8e52003c691eec" }
  ],

  // Dominio proprio da API (F2.34). E o endereco que o cliente ve na
  // documentacao e copia no curl, e e para ele que os webhooks passam a
  // apontar: nao depende mais de qual conta hospeda o Worker.
  "routes": [{ "pattern": "api.playbooklab.com.br", "custom_domain": true }],

  // Faxina de checkouts abandonados (src/lib/limpeza.ts), de hora em hora.
  "triggers": {
    "crons": ["23 * * * *"]
  },

  // Variaveis NAO secretas podem ir em "vars". Segredos, nunca.
  "vars": {
    "ENVIRONMENT": "production",
    // Pagina do painel do cliente na landing (F2.20), hospedada na Vercel
    // (F2.26), no dominio proprio desde 2026-09-13 (F2.33).
    "PORTAL_URL": "https://app.playbooklab.com.br/painel",
    // Remetente dos e-mails transacionais (F2.20). NAO e segredo: vai no
    // cabecalho de todo e-mail que sai. So a RESEND_API_KEY e secret.
    // O endereco precisa ser do dominio verificado no Resend, e e para ele
    // que volta a resposta de quem responde em vez de clicar no link.
    "EMAIL_FROM": "Playbook API <victor@playbooklab.com.br>"
  }
}
